---
import { Plus } from "lucide-react";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.tsx";
import Footer from "../components/Footer.tsx";
import PageHeader from "../components/PageHeader.tsx";
import FinalCTA from "../components/FinalCTA.tsx";
import { faqGroups, faqCta } from "../data/faq";
---

<BaseLayout
  title="FAQ"
  description="Answers on minimum order quantity, free 3D design, sample lead times and fees, acrylic versus PVC foam board, bulk production, packing and FOB / CIF / DDP terms at One Plus Display."
>
  <Header client:load />

  <PageHeader
    title="Frequently Asked Questions"
    subtitle="Minimum order, sampling, materials, lead times, packing and trade terms — the answers buyers ask for first."
    breadcrumbs={[
      { label: "Resources", href: "/news/" },
      { label: "FAQ" },
    ]}
  />

  <main class="flex-grow">
    <section class="section">
      <div class="container-page grid gap-12 lg:grid-cols-12">
        {/* Group index */}
        <nav class="lg:col-span-3" aria-label="FAQ sections">
          <p class="eyebrow mb-4">On this page</p>
          <ul class="space-y-2 text-sm">
            {
              faqGroups.map((group) => (
                <li>
                  <a
                    href={`#${group.title.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`}
                    class="text-gray-600 transition-colors hover:text-primary-600"
                  >
                    {group.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="space-y-14 lg:col-span-9">
          {
            faqGroups.map((group) => (
              <div
                id={group.title.toLowerCase().replace(/[^a-z0-9]+/g, "-")}
                data-animate
              >
                <h2 class="section-title mb-6 text-2xl md:text-3xl">{group.title}</h2>

                <div class="divide-y divide-gray-200 border-y border-gray-200">
                  {group.items.map((item) => (
                    <details class="group py-5">
                      <summary class="flex cursor-pointer list-none items-start justify-between gap-6 font-semibold text-gray-900">
                        <span>{item.question}</span>
                        <Plus
                          className="mt-0.5 h-5 w-5 shrink-0 text-primary-600 transition-transform duration-200 group-open:rotate-45"
                          aria-hidden="true"
                        />
                      </summary>
                      <p class="mt-3 max-w-3xl leading-relaxed text-gray-600">{item.answer}</p>
                    </details>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <FinalCTA title={faqCta.title} description={faqCta.description} />
  </main>

  <Footer />
</BaseLayout>
