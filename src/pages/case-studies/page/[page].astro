---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.tsx";
import Footer from "../../../components/Footer.tsx";
import CaseIndex from "../../../components/CaseIndex.astro";
import { CASE_PAGE_SIZE, caseStudies } from "../../../data/cases";

export function getStaticPaths() {
  const totalPages = Math.max(1, Math.ceil(caseStudies.length / CASE_PAGE_SIZE));

  /* Page 1 is served by /case-studies, so only 2…n are generated here */
  return Array.from({ length: totalPages - 1 }, (_, index) => {
    const currentPage = index + 2;
    return {
      params: { page: String(currentPage) },
      props: { currentPage, totalPages },
    };
  });
}

const { currentPage, totalPages } = Astro.props;
const start = (currentPage - 1) * CASE_PAGE_SIZE;
const items = caseStudies.slice(start, start + CASE_PAGE_SIZE);
---

<BaseLayout
  title={`Case Studies - Page ${currentPage}`}
  description="Acrylic and PVC foam board display programmes built for brands, retail chains and distributors in the US, Europe, Australia and the Middle East — brief, structure, lead time and packing for each one."
>
  <Header client:load />

  <CaseIndex
    items={items}
    breadcrumbs={[
      { label: "Case Studies", href: "/case-studies/" },
      { label: `Page ${currentPage}` },
    ]}
    currentPage={currentPage}
    totalPages={totalPages}
    basePath="/case-studies/"
    pageBasePath="/case-studies/page"
  />

  <Footer />
</BaseLayout>
