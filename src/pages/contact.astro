---
import { Check, Globe, Mail, MapPin, MessageCircle } from "lucide-react";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.tsx";
import Footer from "../components/Footer.tsx";
import PageHeader from "../components/PageHeader.tsx";
import { contactForm, contactPanel } from "../data/contact";
import { inquiryForm, quantitySelect } from "../data/inquiry";
import { images } from "../data/images";
import { site } from "../data/site";
---

<BaseLayout
  title="Contact One Plus Display"
  description="Contact the One Plus Display export team for custom POP display stands. Send your requirements and destination port for a free 3D render, pricing and lead time, or reach the factory directly by email, phone or WhatsApp."
>
  <Header client:load />

  <main class="flex-grow">
    <PageHeader
      width="narrow"
      title="Contact One Plus Display for Custom Display Stands"
      subtitle="Request a custom display stand quote, free 3D mockup, sample review and OEM/ODM production support for B2B retail display programs from 100 sets."
      image={images.contactBanner}
      breadcrumbs={[
        { label: "About Us", href: "/about-us/" },
        { label: "Contact" },
      ]}
    />

    <section class="bg-gray-100 py-12 md:py-16">
      <div class="container-page max-w-6xl">
        <div class="grid items-start gap-8 lg:grid-cols-2 lg:gap-12">
          <!-- Quote panel: white card matching the aside cards, with a
               brand-tinted header band for the title. First in the mobile
               stack, right column at desktop width. -->
          <div
            class="order-1 overflow-hidden rounded-xs border border-gray-200 bg-white shadow-sm lg:order-2"
          >
            <div class="border-b border-primary-100 bg-primary-50 px-6 py-5 md:px-8">
              <h2 class="text-2xl font-bold text-gray-900 md:text-3xl">
                {contactForm.title}
              </h2>
              <p class="mt-2 max-w-[46ch] text-[15px] leading-relaxed text-gray-600">
                {contactForm.subtitle}
              </p>
            </div>
            <form
              action={`mailto:${site.contact.email}`}
              method="post"
              enctype="text/plain"
              class="space-y-5 px-6 py-6 md:px-8 md:py-7"
            >
              <div class="grid gap-5 md:grid-cols-2">
                <div>
                  <label class="form-label" for="contact-name">
                    {contactForm.nameLabel} <span class="text-primary-600">*</span>
                  </label>
                  <input
                    class="form-input"
                    id="contact-name"
                    name="name"
                    type="text"
                    autocomplete="name"
                    required
                  />
                </div>

                <div>
                  <label class="form-label" for="contact-email">
                    {contactForm.emailLabel} <span class="text-primary-600">*</span>
                  </label>
                  <input
                    class="form-input"
                    id="contact-email"
                    name="email"
                    type="email"
                    autocomplete="email"
                    required
                  />
                </div>
              </div>

              <div>
                <label class="form-label" for="company">
                  {contactForm.companyLabel} <span class="text-primary-600">*</span>
                </label>
                <input
                  class="form-input"
                  id="company"
                  name="company"
                  type="text"
                  autocomplete="organization"
                  required
                />
              </div>

              <div>
                <label class="form-label" for="quantity">
                  {contactForm.quantityLabel} <span class="text-primary-600">*</span>
                </label>
                <select class="form-select" id="quantity" name="quantity" required>
                  <option value="" selected disabled>{contactForm.quantityPlaceholder}</option>
                  {quantitySelect.options.map((option) => <option value={option}>{option}</option>)}
                </select>
              </div>

              <div class="rounded-xs bg-primary-50 p-3.5">
                <label
                  class="flex items-start gap-3 text-[15px] leading-relaxed text-gray-700"
                  for="moq"
                >
                  <input
                    class="mt-0.5 h-4 w-4 shrink-0 accent-primary-600"
                    id="moq"
                    name="moq"
                    type="checkbox"
                    required
                  />
                  <span>
                    {contactForm.moqLabel} <span class="text-primary-600">*</span>
                  </span>
                </label>
              </div>

              <div>
                <label class="form-label" for="requirements">
                  {contactForm.messageLabel} <span class="text-primary-600">*</span>
                </label>
                <textarea
                  class="form-textarea"
                  id="requirements"
                  name="requirements"
                  rows="5"
                  placeholder={contactForm.messagePlaceholder}
                  required></textarea>
              </div>

              <div>
                <label class="form-label" for="contact-files">
                  {inquiryForm.uploadLabel}
                  <span class="font-normal text-gray-600">({inquiryForm.uploadNote})</span>
                </label>
                <input
                  class="form-input file:mr-3 file:rounded-xs file:border-0 file:bg-primary-50 file:px-3 file:py-1.5 file:text-sm file:font-semibold file:text-primary-700"
                  id="contact-files"
                  name="files"
                  type="file"
                  accept=".pdf,.png,.jpg,.jpeg,.webp,.ai,.psd,.dwg,.dxf,.step,.stp"
                />
                <p class="mt-1.5 text-[14px] leading-relaxed text-gray-600">
                  {inquiryForm.uploadHint}
                </p>
              </div>

              <p class="rounded-xs bg-primary-50 p-3.5 text-[14px] leading-relaxed text-gray-600">
                Submitting opens your email client with the details above filled in.
                If it does not open, send the same details to
                <a
                  class="font-semibold text-primary-700 underline"
                  href={`mailto:${site.contact.email}`}
                >
                  {site.contact.email}
                </a> or message us on WhatsApp — a 3D render and a quote come back in
                24 hours.
              </p>

              <button type="submit" class="btn-primary min-h-[3.25rem] w-full">
                {contactForm.submit}
              </button>

              <p class="text-[14px] leading-relaxed text-gray-600">{inquiryForm.privacy}</p>
            </form>
          </div>

          <aside class="order-2 space-y-8 lg:order-1">
            <!-- Let's connect: one heading, then the channels behind the form,
                 separated by hairlines instead of boxes. Only the email, WhatsApp
                 and website values are links; the address row is plain text.
                 The cards below cover why this factory, then what to include
                 in a quote request. -->
            <div class="rounded-xs border border-gray-200 bg-white p-6 shadow-sm md:p-8" data-animate>
              <h2 class="text-xl font-bold text-gray-900">{contactPanel.connectTitle}</h2>
              <ul class="mt-4 divide-y divide-gray-200">
                {
                  contactPanel.channels.map((channel) => (
                    <li class="flex gap-4 py-4">
                      <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xs bg-primary-50 text-primary-600">
                        {channel.key === "email" && <Mail className="h-5 w-5" aria-hidden="true" />}
                        {channel.key === "whatsapp" && (
                          <MessageCircle className="h-5 w-5" aria-hidden="true" />
                        )}
                        {channel.key === "factory" && (
                          <MapPin className="h-5 w-5" aria-hidden="true" />
                        )}
                        {channel.key === "website" && (
                          <Globe className="h-5 w-5" aria-hidden="true" />
                        )}
                      </span>
                      <span class="min-w-0">
                        <span class="block text-[15px] font-semibold text-gray-900">
                          {channel.label}
                        </span>
                        <span class="mt-1 block text-[14px] leading-relaxed text-gray-600">
                          {channel.note}
                        </span>
                        {channel.href ? (
                          <a
                            href={channel.href}
                            target={channel.external ? "_blank" : undefined}
                            rel={channel.external ? "noopener" : undefined}
                            class="mt-1.5 inline-block text-[15px] font-semibold break-words text-primary-600 transition-colors hover:text-primary-700"
                          >
                            {channel.value}
                          </a>
                        ) : (
                          <span class="mt-1.5 block text-[15px] font-semibold break-words text-gray-900">
                            {channel.value}
                          </span>
                        )}
                      </span>
                    </li>
                  ))
                }
              </ul>
            </div>

            <div class="rounded-xs border border-gray-200 bg-white p-6 shadow-sm md:p-8" data-animate>
              <h2 class="text-lg font-bold text-gray-900">
                {contactPanel.whyTitle}
              </h2>
              <ul class="mt-4 space-y-2.5 text-[15px] leading-relaxed text-gray-600">
                {
                  contactPanel.whyPoints.map((point) => (
                    <li class="flex gap-2">
                      <Check className="mt-1 h-4 w-4 shrink-0 text-primary-600" aria-hidden="true" />
                      <span>{point}</span>
                    </li>
                  ))
                }
              </ul>
            </div>

            <div class="rounded-xs border border-gray-200 bg-white p-6 shadow-sm md:p-8" data-animate>
              <h2 class="text-lg font-bold text-gray-900">
                {contactPanel.guideTitle}
              </h2>
              <p class="mt-3 text-[15px] leading-relaxed text-gray-600">
                {contactPanel.guideIntro}
              </p>
              <ul class="mt-4 space-y-2.5 text-[15px] leading-relaxed text-gray-600">
                {
                  contactPanel.guidePoints.map((point) => (
                    <li class="flex gap-2">
                      <Check className="mt-1 h-4 w-4 shrink-0 text-primary-600" aria-hidden="true" />
                      <span>{point}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </aside>
        </div>

        <!-- Factory map: Leaflet + Esri light-gray tiles, same setup as the CN site.
             Full width under both columns, so the 1:1 grid never leaves a tall gap.
             Interactions (drag / scroll zoom) stay off until the visitor opts in. -->
        <link rel="stylesheet" href="/vendor/leaflet/leaflet.css" />
        <script is:inline src="/vendor/leaflet/leaflet.js"></script>
        <div
          id="factory-map"
          class="relative mt-10 h-[320px] w-full overflow-hidden rounded-xs border border-gray-200 bg-white shadow-sm md:mt-12 md:h-[400px]"
          data-lat={site.contact.mapLat}
          data-lng={site.contact.mapLng}
          data-address={site.contact.address}
        >
          <button
            type="button"
            class="absolute top-3 right-3 z-[900] flex items-center gap-1.5 rounded-xs bg-white px-3 py-1.5 text-xs font-medium text-gray-700 shadow-md transition-colors hover:text-primary-600"
          >
            <svg
              class="h-3.5 w-3.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m21 21-4.3-4.3"></path>
              <path d="M11 8v6M8 11h6"></path>
            </svg>
            <span>Click to enable zoom</span>
          </button>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    /* Minimal typings for the Leaflet build loaded from the CDN above */
    interface LeafletMap {
      dragging: { enable: () => void };
      touchZoom: { enable: () => void };
      doubleClickZoom: { enable: () => void };
      scrollWheelZoom: { enable: () => void };
      boxZoom: { enable: () => void };
      keyboard: { enable: () => void };
    }
    interface LeafletLib {
      map(el: HTMLElement, options: Record<string, unknown>): LeafletMap;
      tileLayer(
        url: string,
        options: Record<string, unknown>,
      ): { addTo: (map: LeafletMap) => void };
      divIcon(options: Record<string, unknown>): unknown;
      marker(
        coords: [number, number],
        options: Record<string, unknown>,
      ): {
        addTo: (map: LeafletMap) => {
          bindPopup: (html: string, options?: Record<string, unknown>) => void;
        };
      };
    }
    declare const L: LeafletLib;

    const frame = document.getElementById("factory-map");
    if (frame && typeof L !== "undefined") {
      const lat = Number(frame.dataset.lat) || 23.115;
      const lng = Number(frame.dataset.lng) || 113.759;
      const address = frame.dataset.address ?? "";

      const map = L.map(frame, {
        center: [lat, lng],
        zoom: 3,
        minZoom: 2,
        maxZoom: 18,
        zoomControl: true,
        attributionControl: true,
        scrollWheelZoom: false,
        dragging: false,
        touchZoom: false,
        doubleClickZoom: false,
        boxZoom: false,
        keyboard: false,
      });

      L.tileLayer(
        "https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Base/MapServer/tile/{z}/{y}/{x}",
        {
          attribution:
            '&copy; <a href="https://www.esri.com/" target="_blank" rel="noopener">Esri</a>',
          maxZoom: 16,
        },
      ).addTo(map);

      const pinIcon = L.divIcon({
        className: "opd-map-pin",
        html: '<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path fill="#E53935" stroke="#FFFFFF" stroke-width="1.5" d="M12 2C8.1 2 5 5.1 5 9c0 5.2 7 13 7 13s7-7.8 7-13c0-3.9-3.1-7-7-7z"/><circle cx="12" cy="9" r="2.7" fill="#FFFFFF"/></svg>',
        iconSize: [40, 40],
        iconAnchor: [20, 37],
      });

      L.marker([lat, lng], { icon: pinIcon })
        .addTo(map)
        .bindPopup(
          `<strong>One Plus Display Factory</strong><br/>${address}`,
          { closeButton: true, autoPan: true },
        );

      const activateButton = frame.querySelector("button");
      frame.addEventListener("click", () => {
        map.dragging.enable();
        map.touchZoom.enable();
        map.doubleClickZoom.enable();
        map.scrollWheelZoom.enable();
        map.boxZoom.enable();
        map.keyboard.enable();
        activateButton?.classList.add("hidden");
      });
    }
  </script>
</BaseLayout>
